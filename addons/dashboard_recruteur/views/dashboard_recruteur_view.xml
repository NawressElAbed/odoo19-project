    <record id="view_applicant_email_list" model="ir.ui.view">
    <field name="name">hr.applicant.email.list</field>
    <field name="model">hr.applicant</field>
    <field name="arch" type="xml">
        <list string="Emails des candidats">
            <field name="email_from"/>
        </list>
    </field>
</record>
    <record id="view_quiz_result" model="ir.ui.view">
    <field name="name">quiz.result.form</field>
    <field name="model">blank.page</field>
    <field name="arch" type="xml">
        <form>
            <sheet>

                <div style="
                    background-color: #c299dc !important;
                    color: white;
                    padding: 40px;
                    border-radius: 20px;
                    text-align: center;
                ">

                    <h1 style="color: white">🎯 Résultat du Quiz</h1>

                    <p>
                        Vous avez répondu correctement à
                        <strong><field name="score"/></strong>
                        / <field name="total_questions"/> questions
                    </p>

                    <div style="
                        margin:30px auto;
                        width:150px;
                        height:150px;
                        border-radius:50%;
                        background:white;
                        color:#764ba2;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:35px;
                        font-weight:bold;
                    ">
                        <field name="pourcentage"/>%
                    </div>

                    <div style="width:80%; margin:auto;">
                        <field name="pourcentage" widget="progressbar"/>
                    </div>

                    <h2 style="margin-top:20px; color: white">
                        <field name="message"/>
                    </h2>

                </div>

            </sheet>
        </form>
    </field>
</record>
    <record id="view_quiz_result_mobile" model="ir.ui.view">
    <field name="name">quiz.result.mobile</field>
    <field name="model">blank.page.mobile</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <h2>Résultat Quiz Mobile</h2>
                <p>Score : <field name="score"/> / 6</p>
                <p>Pourcentage : <field name="pourcentage"/>%</p>
                <h3><field name="message"/></h3>
            </sheet>
        </form>
    </field>
</record>
    <record id="view_quiz_result_resource" model="ir.ui.view">
    <field name="name">quiz.result.resource</field>
    <field name="model">blank.page.resource</field>
    <field name="arch" type="xml">
