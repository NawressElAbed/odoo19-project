            </sheet>
        </form>
    </field>
</record>
   <record id="ir_cron_auto_interview" model="ir.cron">
    <field name="name">Planification automatique entretiens</field>
    <field name="model_id" ref="model_interview_auto"/>
    <field name="state">code</field>
    <field name="code">model.cron_schedule_interviews()</field>

    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
</record>
<record id="view_static_dashboard_kanban_sidebar" model="ir.ui.view">
    <field name="name">static.dashboard.sidebar</field>
    <field name="model">static.dashboard</field>
    <field name="inherit_id" ref="dashboard_recruteur.view_static_dashboard_kanban"/>
    <field name="arch" type="xml">

        <xpath expr="//kanban" position="attributes">
            <attribute name="class">
                o_kanban_dashboard o_dashboard_recruteur dashboard_with_sidebar
            </attribute>
        </xpath>

        <xpath expr="//t[@t-name='card']" position="inside">

            <div class="my_sidebar">
                <h3>Dashboard</h3>

                <ul>
                    <li>🏠 Accueil</li>
                    <li>
    <button type="object"
            name="action_open_blank_page"
            class="btn btn-link custom-white-btn">
        💻 Développement Web
    </button>
</li>
                    <li><button type="object" name="action_open_blank_page_mobile" class="btn btn-link custom-white-btn">📱 Développement Mobile</button></li>
                    <li><button type="object" name="action_open_blank_page_resource" class="btn btn-link custom-white-btn">👥 RH</button></li>
<li>
    <a href="/odoo/settings"
       style="color:white; text-decoration:none;">
       ⚙️ Paramètres
    </a>
</li>
                    <li>🚪 Déconnexion</li>
                </ul>

            </div>

        </xpath>

    </field>
</record>

    <menuitem id="menu_static_dashboard_root" name="Tableau de bord" sequence="1"/>
    <menuitem id="menu_static_dashboard" name="Vue statique"
              parent="menu_static_dashboard_root"
              action="action_static_dashboard"/>
</odoo>
